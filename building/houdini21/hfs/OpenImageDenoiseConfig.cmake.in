# OpenImageDenoise @OIDN_VERSION@ as shipped inside Houdini (@HFS@).
# Generated by building/houdini21/hfs. Its CPU and CUDA device modules are
# loaded at runtime from the same directory.

if(NOT TARGET OpenImageDenoise)
    add_library(OpenImageDenoise SHARED IMPORTED)
    # Houdini's libOpenImageDenoise.so.2 carries a RUNPATH pointing at
    # SideFX's build machine, so on its own it cannot find its core library
    # outside Houdini. Linking the core directly lets our RUNPATH load it
    # first; the loader then reuses it by soname.
    set_target_properties(OpenImageDenoise PROPERTIES
        IMPORTED_LOCATION "@HFS_DSOLIB@/libOpenImageDenoise.so.2"
        INTERFACE_INCLUDE_DIRECTORIES "@SHIM_INC@"
        INTERFACE_LINK_LIBRARIES "@HFS_DSOLIB@/libOpenImageDenoise_core.so.@OIDN_VERSION@")
endif()
set(OpenImageDenoise_VERSION "@OIDN_VERSION@")
