# USD as shipped inside Houdini (@HFS@). Generated by building/houdini21/hfs;
# do not edit, re-run the dependency build instead.
#
# Provides the same targets and variables as a stock USD install's
# pxrConfig.cmake: PXR_VERSION, PXR_INCLUDE_DIRS, PXR_LIBRARIES and one
# imported target per library (usd, hd, tf, ...).

if(TARGET usd)
    return()
endif()

set(PXR_MAJOR_VERSION "@PXR_MAJOR_VERSION@")
set(PXR_MINOR_VERSION "@PXR_MINOR_VERSION@")
set(PXR_PATCH_VERSION "@PXR_PATCH_VERSION@")
set(PXR_VERSION "@PXR_VERSION@")
set(PXR_INCLUDE_DIRS "@SHIM_INC@;@HFS_PYTHON_INC@")
set(PXR_LIBRARIES "@PXR_TARGET_NAMES@")

include(CMakeFindDependencyMacro)
find_dependency(TBB CONFIG PATHS "${CMAKE_CURRENT_LIST_DIR}/../TBB" NO_DEFAULT_PATH)

# USD's headers include Python.h, so consumers need libpython directly.
if(NOT TARGET pxr_houdini_python)
    add_library(pxr_houdini_python SHARED IMPORTED)
    set_target_properties(pxr_houdini_python PROPERTIES
        IMPORTED_LOCATION "@HFS_PYTHON_LIB@"
        INTERFACE_INCLUDE_DIRECTORIES "@HFS_PYTHON_INC@")
endif()

function(_pxr_add_target name lib deps)
    add_library(${name} SHARED IMPORTED)
    set_target_properties(${name} PROPERTIES
        IMPORTED_LOCATION "@HFS_DSOLIB@/${lib}"
        INTERFACE_INCLUDE_DIRECTORIES "@SHIM_INC@"
        INTERFACE_LINK_LIBRARIES "${deps};TBB::tbb;pxr_houdini_python"
        # Lets the linker resolve the indirect Houdini deps of these libs
        # (libpython, hboost, osd...) without putting them on our link line.
        INTERFACE_LINK_OPTIONS "LINKER:-rpath-link,@HFS_DSOLIB@:@HFS@/python/lib")
endfunction()

@PXR_TARGET_DEFS@
