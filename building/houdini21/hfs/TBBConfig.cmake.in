# oneTBB @TBB_VERSION@ as shipped inside Houdini (@HFS@). Generated by
# building/houdini21/hfs. Mirrors the targets of oneTBB's own TBBConfig.cmake.

set(TBB_VERSION "@TBB_VERSION@")
set(TBB_IMPORTED_TARGETS "")

foreach(_tbb_comp tbb tbbmalloc tbbmalloc_proxy)
    if(NOT TARGET TBB::${_tbb_comp})
        if(_tbb_comp STREQUAL "tbb")
            set(_tbb_so "libtbb.so.12")
        else()
            set(_tbb_so "lib${_tbb_comp}.so.2")
        endif()
        add_library(TBB::${_tbb_comp} SHARED IMPORTED)
        set_target_properties(TBB::${_tbb_comp} PROPERTIES
            IMPORTED_LOCATION "@HFS_DSOLIB@/${_tbb_so}"
            INTERFACE_INCLUDE_DIRECTORIES "@SHIM_INC@")
    endif()
    set(TBB_${_tbb_comp}_FOUND TRUE)
    list(APPEND TBB_IMPORTED_TARGETS TBB::${_tbb_comp})
endforeach()
unset(_tbb_so)
unset(_tbb_comp)
